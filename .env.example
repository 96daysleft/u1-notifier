# Snapmaker U1 Moonraker Connection
PRINTER_IP=192.168.1.50
PRINTER_PORT=80

# Optional Moonraker API key (only needed if the printer requires trusted-client auth)
# MOONRAKER_API_KEY=

# Discord Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Polling Configuration
POLL_INTERVAL_MINUTES=5
MAX_ALERTS_PER_POLL=10

# Logging Configuration
LOG_LEVEL=info

# Connection Settings
SKIP_CONNECTION_TEST=true

# Notification Settings
NOTIFY_ON_PRINT_START=true
NOTIFY_ON_PRINT_FINISH=true
NOTIFY_ON_ERROR=true

# Progress milestone alerts
NOTIFY_ON_PROGRESS=true
PROGRESS_MILESTONES=25,50,75

# Camera snapshot attached to Discord alerts
# Defaults to http://<PRINTER_IP>/server/files/camera/monitor.jpg if unset
# CAMERA_SNAPSHOT_URL=http://192.168.1.50/server/files/camera/monitor.jpg
NOTIFY_WITH_SNAPSHOT=true
